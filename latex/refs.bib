@misc{pbrt4ed_chapters,
  author={Pharr, Matt and Jakob, Wenzel and Humphreys, Greg},
  title={Physically Based Rendering: From Theory to Implementation (4th Edition) -- Chapters Online},
  year={2023},
  howpublished={MIT Press e Disponível online},
  note={
    \begin{itemize}
    \item \S2 \emph{Monte Carlo Integration}: Basics, Importance Sampling, Inversion Method, Transforming Distributions, Multiple Importance Sampling, Russian Roulette
    \item \S3 \emph{Geometry and Transformations}: Vectors, Coordinate Systems
    \item \S6 \emph{Shapes}: Triangle Meshes, Area Sampling
    \item \S9 \emph{Reflection Models}: Lambertian Diffuse, Specular Reflection/Transmission, Dielectric BSDF, Conductor BRDF, Microfacet Theory (D, G, F), VNDF Sampling
    \item \S12 \emph{Light Sources}: Area Lights, Infinite Area Lights, Light Sampling
    \item \S13 \emph{Light Transport I -- Surface Reflection}: The Light Transport Equation, Path Tracing, Simple Path Tracer, Better Path Tracer
    \item \SA \emph{Appendices}: Sampling Multidimensional Functions
    \end{itemize}
    URL: \url{https://pbr-book.org/4ed/contents}
  }
}

@misc{pbrt3ed_chapter16,
