\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Showcase --- \texttt  {mis} (512$\times $512, SPP=64, estratificado, depth=12, $\approx $102 min): combina BSDF e NEE com heurística de potência ($\beta =2$); menor variância em superfícies difusas e especulares.}}{8}{figure.18}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Showcase --- \texttt  {mis} + Roleta Russa (512$\times $512, SPP=64, estratificado, depth=12, $\approx $70 min): mesma média, terminação probabilística de caminhos profundos.}}{8}{figure.19}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Cena combinada, \texttt  {bsdf\_only} em SPP=4 (depth=10, sem RR): amostragem por BSDF pura quase inutilizável --- ruído ``sal e pimenta'' domina toda a cena, inclusive a esfera espelhada.}}{8}{figure.20}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Comparação de modos e convergência.}{8}{Item.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Cena combinada, \texttt  {bsdf\_only} em SPP=32 (depth=10, sem RR, 19{,}6 min): cena já discernível, mas ainda granulada; as fontes de luz são raramente acertadas por raios amostrados pela BSDF.}}{9}{figure.21}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Cena combinada, \texttt  {nee\_only} em SPP=4 (depth=10, sem RR): iluminação direta das 3 fontes já legível mesmo com poucos \emph  {samples}, pois NEE reduz a variância da luz direta a quase zero; sombras geométricas pretas.}}{9}{figure.22}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces Cena combinada, \texttt  {nee\_only} em SPP=32 (depth=10, sem RR, 47{,}3 min): superfícies difusas limpas; a esfera espelhada reflete apenas geometria diretamente iluminada (sem reverberação/\emph  {color bleeding}).}}{9}{figure.23}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces Cena combinada, \texttt  {mis} em SPP=4 (depth=10, sem RR): combinação BSDF+NEE já produz imagem plausível com pouquíssimos \emph  {samples}; menos ruído que \texttt  {bsdf\_only} e mais informação indireta que \texttt  {nee\_only}.}}{9}{figure.24}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {25}{\ignorespaces Cena combinada, \texttt  {mis} em SPP=32 (depth=10, sem RR, 50{,}7 min): resultado balanceado --- a esfera espelhada reflete o ambiente com \emph  {color bleeding}; as dielétricas mostram refração e cáusticas; transições luz-sombra suaves.}}{10}{figure.25}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {26}{\ignorespaces Cena combinada, \texttt  {mis}+RR em SPP=4 (depth=10, com RR): praticamente idêntica ao \texttt  {mis} sem RR no mesmo SPP --- a Roleta Russa não altera a média, apenas encurta caminhos de baixo \emph  {throughput}.}}{10}{figure.26}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {27}{\ignorespaces Cena combinada, \texttt  {mis}+RR em SPP=32 (depth=10, com RR, 36{,}2 min): visualmente equivalente ao \texttt  {mis} sem RR (50{,}7 min), porém $-28{,}6\%$ no tempo de render; estimador permanece não-viesado.}}{10}{figure.27}\protected@file@percent }
