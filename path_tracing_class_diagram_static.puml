@startuml path_tracing_class_diagram_static
' ============================================================
' Diagrama de Classes (ESTÁTICO) — src/path_tracing
' Foco: geometria (shape + BVH), materiais, luzes e entidades
' estruturais da cena. Forçado a uma única página.
' ============================================================

title Diagrama de Classes — src/path_tracing (ESTÁTICO)\nGeometria, materiais, luzes

page 1 1
top to bottom direction
skinparam classAttributeIconSize 0
hide empty members
hide methods
skinparam linetype ortho
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #888
  FontStyle bold
}
skinparam class {
  BorderColor #555
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #EFEFEF
}
skinparam dpi 150
skinparam pageMargin 10
scale 0.55

' ============================================================
' 1. Entidades estruturais da cena
' ============================================================
package "path_tracing (raiz — entidades estruturais)" as root {
  class Ray {
    +origin: glm.vec3
    +direction: glm.vec3
  }
  class Hit {
    +t: float
    +pos: glm.vec3
    +normal: glm.vec3
    +geo_normal: glm.vec3
    +material: Material | None
    +light: Light | None
    +front_face: bool
    +backfacing: bool
  }
  class Camera {
    +eye, center, up: glm.vec3
    +fov: float
    +width, height: int
    +focal_distance: float
  }
  enum SamplingMode {
    REGULAR
    UNIFORM
    STRATIFIED
    JITTERED
  }
  class Film {
    +width, height: int
    +samples_per_pixel: int
    +sampling_mode: SamplingMode
    +seed: int | None
  }
  class ONB {
    +u, v, w: glm.vec3
  }
  class Scene {
    +objects: list[Shape]
    +lights: list[Light]
    +ambient_light: glm.vec3
    +background_color: glm.vec3
    +max_depth: int
    +ray_epsilon: float
  }
  class AmbientLight {
    +color: glm.vec3
  }
}

' ============================================================
' 2. shape
' ============================================================
package "shape" {
  note as ShapeNote
    shape.py
    Slide 4, p. 35 e p. 47-48 — fluxo de closest-hit.
  end note

  abstract class Shape {
    +material: Any
  }

  class Sphere {
    +center: glm.vec3
    +radius: float
  }
  class Plane {
    +pos: glm.vec3
    +normal: glm.vec3
  }
  class Box {
    +p_min, p_max: glm.vec3
  }
  class Triangle {
    +v0, v1, v2: glm.vec3
    +e1, e2: glm.vec3
    +geo_normal: glm.vec3
  }
  class TriangleMesh {
    +triangles: list[Triangle]
    +material: Any
    +vertices: list[glm.vec3]
    +faces: list[tuple]
    +name: str
    +accelerator: str
    +bvh: TriangleBVH | None
  }
  abstract class Instance {
    +shape: Shape
    +m: glm.mat4
    +m_inv: glm.mat4
    +m_inv_t: glm.mat4
  }
  class Translate
  class Rotate
}

Shape <|-- Sphere
Shape <|-- Plane
Shape <|-- Box
Shape <|-- Triangle
Shape <|-- TriangleMesh
Shape <|-- Instance
Instance <|-- Translate
Instance <|-- Rotate

' ============================================================
' 3. triangle_bvh
' ============================================================
package "triangle_bvh" {
  note as BvhNote
    triangle_bvh.py
    BVH local a TriangleMesh (median split, sem SAH).
  end note

  class AABB {
    +p_min, p_max: glm.vec3
  }
  class TriangleBVHNode {
    +bounds: AABB
    +triangles: list | None
    +left, right: TriangleBVHNode | None
    +depth: int
  }
  class TriangleBVH {
    +root: TriangleBVHNode
    +node_count: int
    +leaf_count: int
    +max_depth: int
  }
}

TriangleBVHNode *-- AABB
TriangleBVH *-- TriangleBVHNode

' ============================================================
' 4. bsdf
' ============================================================
package "bsdf" {
  note as BsdfNote
    bsdf/base.py + bsdf/*.py
    Ref: PBRT 4e §9 "Reflection Models"
    is_specular()=True em DielectricBSDF → NEE pula.
  end note

  abstract class BSDF {
    +eval(wo, wi): glm.vec3
    +sample(wo, u): dict | None
    +pdf(wo, wi): float
    +is_specular(): bool
  }

  class LambertianBSDF {
    +rho: glm.vec3
  }
  class EmissiveBSDF {
    +Le: glm.vec3
  }
  class DielectricBSDF {
    +ior: float
    +absorption: glm.vec3
  }
}

BSDF <|-- LambertianBSDF
BSDF <|-- EmissiveBSDF
BSDF <|-- DielectricBSDF

' ============================================================
' 5. materials (legado)
' ============================================================
package "materials (legado ray-tracing)" {
  note as MatNote
    Interface legada usada pelo traçador recursivo do Proj1.
    Path tracer usa BSDF diretamente.
  end note

  abstract class Material << (A,#FFE0E0) >> {
    +eval(scene, hit, ray, depth, max_depth)
    +shadow_transmittance(...)
  }

  class PhongMaterial {
    +diffuse: glm.vec3
    +specular: glm.vec3
    +shininess: float
  }
  class ReflectiveMaterial {
    +reflective_color: glm.vec3
  }
  class TransparentMaterial {
    +transparency: float
    +ior: float
  }
  class EmissiveMaterial {
    +emission: glm.vec3
    +shadow_passthrough: bool
  }
}

Material <|-- PhongMaterial
PhongMaterial <|-- ReflectiveMaterial
PhongMaterial <|-- TransparentMaterial
Material <|-- EmissiveMaterial

' ============================================================
' 6. lights
' ============================================================
package "lights" {
  note as LightsNote
    lights/*.py
    NEE + MIS usam sample_Li() / pdf_Li().
    is_delta=True em PointLight → MIS weight=1.0.
  end note

  abstract class Light {
    +is_delta: bool
    +sample_Li(ref, u)
    +pdf_Li(ref, wi)
  }

  class PointLight {
    +pos: glm.vec3
    +power: glm.vec3
  }

  enum AreaLightSamplingMode {
    REGULAR
    UNIFORM
    STRATIFIED
  }

  class AreaLight {
    +p, e_u, e_v: glm.vec3
    +power, Le: glm.vec3
  }
  class RectAreaLight {
    +corner, edge_u, edge_v: glm.vec3
    +Le: glm.vec3
    +normal: glm.vec3
    +area: float
    +center: glm.vec3
  }

  class _BvhTriangle << (P,#E0FFE0) >> {
    +v0, v1, v2: glm.vec3
    +e1, e2: glm.vec3
    +normal: glm.vec3
    +area: float
  }

  class TriangleMeshLight {
    +vertices: list[glm.vec3]
    +faces: list[tuple]
    +Le: glm.vec3
    +triangles: list[_BvhTriangle]
    +total_area: float
    +cdf: list[float]
    +_bvh: TriangleBVH
  }
}

Light <|-- PointLight
Light <|-- AreaLight
Light <|-- RectAreaLight
Light <|-- TriangleMeshLight
AreaLight ..> AreaLightSamplingMode

TriangleMeshLight *-- TriangleBVH
TriangleMeshLight *-- _BvhTriangle

' ============================================================
' Relacionamentos cross-package
' ============================================================

Scene "1" *-- "*" Shape
Scene "1" *-- "*" Light
TriangleMesh o-- TriangleBVH
_BvhTriangle ..> Triangle : "mesmo contrato intersect(ray,hit)"
Film ..> Camera
Film ..> Scene
Film ..> SamplingMode
Camera ..> Ray
Hit ..> Ray : "set_face_normal()"

@enduml
